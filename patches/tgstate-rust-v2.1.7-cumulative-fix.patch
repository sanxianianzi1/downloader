+pub const TG_UPLOAD_MAX_RETRIES: u32 = 8;
+
+/// Process-wide limit on concurrent `sendDocument` calls across ALL upload
+/// requests. Telegram rate-limits a bot's large-file uploads by accumulated
+/// volume; parallel multi-file uploads are the fastest way to hit the flood
+/// control (often returned as a 400-wrapped "too Many Requests"), so the
+/// default serializes uploads globally. Overridable at runtime via
