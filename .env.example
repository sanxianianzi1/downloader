BOT_TOKEN=123456:ABC-your-bot-token
GITHUB_TOKEN=github_pat_your_fine_grained_token
GITHUB_REPO=your-name/your-repo
ALLOWED_USER_IDS=123456789
TGSTATE_PUBLIC_URL=https://tgstate.example.com
COOKIE_SECURE=0
TRUST_FORWARDED_FOR=0

# bot 管理面密钥（必填，两处一致才能启用 /ls /mkdir 等命令）
# 生成方式：openssl rand -hex 24
TGSTATE_BOT_KEY=在这里填随机密钥

# 夸克 Cookie 保活刷新周期（分钟），默认 90，0 = 关闭保活
QUARK_KEEPALIVE_MINUTES=90
