+
+#[derive(Debug, Clone, serde::Serialize)]
+pub struct Folder {
+    pub id: i64,
+    pub name: String,
+    pub parent_id: Option<i64>,
+    pub folder_count: i64,
+    pub file_count: i64,
+}
+
+#[derive(Debug, Clone)]
+pub struct SubtreeFile {
+    pub filename: String,
+    pub file_id: String,
+    pub short_id: Option<String>,
+    pub filesize: i64,
+}
+
+const FOLDER_COLS: &str =
+    "(SELECT COUNT(*) FROM folders c WHERE c.parent_id = f.id) AS folder_count, \
+     (SELECT COUNT(*) FROM files fi WHERE fi.folder_id = f.id) AS file_count";
+
+fn row_to_folder(row: &rusqlite::Row<'_>) -> rusqlite::Result<Folder> {
+    Ok(Folder {
+        id: row.get(0)?,
+        name: row.get(1)?,
+        parent_id: row.get(2).ok(),
+        folder_count: row.get(3).unwrap_or(0),
+        file_count: row.get(4).unwrap_or(0),
+    })
+}
+
+/// 列出某目录的直接子目录（含计数）与文件。parent 传 None 表示根目录。
+pub fn list_folder_children(
+    pool: &DbPool,
+    parent: Option<i64>,
+) -> Result<(Vec<Folder>, Vec<FileMetadata>), AppErrorKind> {
+    let conn = pool.get()?;
+
+    let (where_clause, params_ref): (&str, Vec<Option<i64>>) = if parent.is_some() {
+        ("WHERE f.parent_id = ?1", vec![parent])
+    } else {
+        ("WHERE f.parent_id IS NULL", vec![])
+    };
+
+    let sql = format!(
+        "SELECT f.id, f.name, f.parent_id, {} FROM folders f {} ORDER BY f.name COLLATE NOCASE",
+        FOLDER_COLS, where_clause
+    );
+    let mut stmt = conn.prepare(&sql)?;
+    let folders = stmt
+        .query_map(rusqlite::params_from_iter(params_ref.iter()), row_to_folder)?
+        .filter_map(|r| r.ok())
+        .collect();
+
+    let files = if parent.is_some() {
+        query_folder_files(&conn, "WHERE folder_id = ?1", &[parent])?
+    } else {
+        query_folder_files(&conn, "WHERE folder_id IS NULL", &[])?
+    };
+
+    Ok((folders, files))
+}
+
+fn query_folder_files(
+    conn: &rusqlite::Connection,
+    where_clause: &str,
+    params: &[Option<i64>],
+) -> Result<Vec<FileMetadata>, AppErrorKind> {
+    let sql = format!(
+        "SELECT filename, file_id, filesize, upload_date, short_id, share_password, folder_id FROM files {} \
+         ORDER BY filename COLLATE NOCASE",
+        where_clause
+    );
+    let mut stmt = conn.prepare(&sql)?;
+    let files = stmt
+        .query_map(rusqlite::params_from_iter(params.iter()), |row| {
+            Ok(FileMetadata {
+                filename: row.get(0)?,
+                file_id: row.get(1)?,
+                filesize: row.get(2)?,
+                upload_date: row.get::<_, String>(3).unwrap_or_default(),
+                short_id: row.get(4).ok(),
+                share_password: norm_share_password(row.get(5).ok()),
+                folder_id: row.get(6).ok(),
+            })
+        })?
+        .filter_map(|r| r.ok())
+        .collect();
+    Ok(files)
+}
+
+/// 创建目录；name 由调用方校验（非空、无路径分隔符）。
+pub fn create_folder(
+    pool: &DbPool,
+    name: &str,
+    parent_id: Option<i64>,
+) -> Result<Folder, AppErrorKind> {
+    let conn = pool.get()?;
+    conn.execute(
+        "INSERT INTO folders (name, parent_id) VALUES (?1, ?2)",
+        params![name, parent_id],
+    )?;
+    let id = conn.last_insert_rowid();
+    Ok(Folder {
+        id,
+        name: name.to_string(),
+        parent_id,
+        folder_count: 0,
+        file_count: 0,
+    })
+}
+
+pub fn get_folder(pool: &DbPool, id: i64) -> Result<Option<Folder>, AppErrorKind> {
+    let conn = pool.get()?;
+    let result = conn.query_row(
+        &format!("SELECT f.id, f.name, f.parent_id, {} FROM folders f WHERE f.id = ?1", FOLDER_COLS),
+        params![id],
+        row_to_folder,
+    );
+    match result {
+        Ok(f) => Ok(Some(f)),
+        Err(rusqlite::Error::QueryReturnedNoRows) => Ok(None),
+        Err(e) => Err(e.into()),
+    }
+}
+
+/// 从指定目录沿 parent 链向上收集，返回根 → 当前顺序的面包屑。
+/// 根节点为 { id: None, name: "根目录" }；目录不存在或链断裂时返回仅含根。
+pub fn get_folder_path(pool: &DbPool, folder_id: Option<i64>) -> Vec<Folder> {
+    let root = Folder {
+        id: 0,
+        name: "根目录".to_string(),
+        parent_id: None,
+        folder_count: 0,
+        file_count: 0,
+    };
+    let mut chain: Vec<Folder> = Vec::new();
+    let mut cur = folder_id;
+    let mut guard = 0;
+    while let Some(id) = cur {
+        guard += 1;
+        if guard > 64 {
+            // 防御异常数据成环：直接退回根视图。
+            return vec![root];
+        }
+        match get_folder(pool, id) {
+            Ok(Some(f)) => {
+                cur = f.parent_id;
+                chain.push(f);
+            }
+            _ => return vec![root],
+        }
+    }
+    let mut path = vec![root];
+    path.extend(chain.into_iter().rev());
+    path
+}
+
+/// 目录改名。返回是否命中。
+pub fn rename_folder(pool: &DbPool, id: i64, name: &str) -> Result<bool, AppErrorKind> {
+    let conn = pool.get()?;
+    let rows = conn.execute("UPDATE folders SET name = ?1 WHERE id = ?2", params![name, id])?;
+    Ok(rows > 0)
+}
+
+/// 文件在目录间移动（target 为 None 表示移回根目录）。
+/// identifier 可以是 short_id 或复合 file_id。返回是否命中。
+pub fn set_file_folder(
+    pool: &DbPool,
+    identifier: &str,
+    target: Option<i64>,
+) -> Result<bool, AppErrorKind> {
+    let conn = pool.get()?;
+    let rows = conn.execute(
+        "UPDATE files SET folder_id = ?1 WHERE short_id = ?2 OR file_id = ?2",
+        params![target, identifier],
+    )?;
+    Ok(rows > 0)
+}
+
+/// 文件改名。返回是否命中。
+pub fn rename_file_metadata(
+    pool: &DbPool,
+    identifier: &str,
+    new_name: &str,
+) -> Result<bool, AppErrorKind> {
+    let conn = pool.get()?;
+    let rows = conn.execute(
+        "UPDATE files SET filename = ?1 WHERE short_id = ?2 OR file_id = ?2",
+        params![new_name, identifier],
+    )?;
+    Ok(rows > 0)
+}
+
+/// 递归收集目录子树：全部目录 id（含自身）+ 全部文件的元数据。
+/// 用递归 CTE 一次查询，避免逐层往返。
+pub fn collect_subtree(
+    pool: &DbPool,
+    root_id: i64,
+) -> Result<(Vec<i64>, Vec<SubtreeFile>), AppErrorKind> {
+    let conn = pool.get()?;
+    let cte = "WITH RECURSIVE sub(id) AS ( \
+               SELECT ?1 UNION ALL \
+               SELECT f.id FROM folders f JOIN sub s ON f.parent_id = s.id) ";
+
+    let sql = format!("{} SELECT id FROM sub", cte);
+    let mut stmt = conn.prepare(&sql)?;
+    let folder_ids: Vec<i64> = stmt
+        .query_map(params![root_id], |row| row.get(0))?
+        .filter_map(|r| r.ok())
+        .collect();
+
+    let sql = format!(
+        "{} SELECT fi.filename, fi.file_id, fi.short_id, fi.filesize \
+         FROM files fi JOIN sub ON fi.folder_id = sub.id",
+        cte
+    );
+    let mut stmt = conn.prepare(&sql)?;
+    let files: Vec<SubtreeFile> = stmt
+        .query_map(params![root_id], |row| {
+            Ok(SubtreeFile {
+                filename: row.get(0)?,
+                file_id: row.get(1)?,
+                short_id: row.get(2).ok(),
+                filesize: row.get(3)?,
+            })
+        })?
+        .filter_map(|r| r.ok())
+        .collect();
+
+    Ok((folder_ids, files))
+}
+
+/// 按 id 批量删除目录行。返回删除的行数。
+pub fn delete_folders_by_ids(pool: &DbPool, ids: &[i64]) -> Result<usize, AppErrorKind> {
+    let conn = pool.get()?;
+    let mut deleted = 0;
+    for id in ids {
+        deleted += conn.execute("DELETE FROM folders WHERE id = ?1", params![id])?;
+    }
+    Ok(deleted)
+}
+
+// ------------------------------------------------------------------
+// 通用 KV 存储（kv_store 表）：目前存放夸克直链 Cookie 等运行期凭据
+// ------------------------------------------------------------------
+
+/// 读 KV；键不存在返回 None。
+pub fn kv_get(pool: &DbPool, key: &str) -> Result<Option<String>, AppErrorKind> {
+    let conn = pool.get()?;
+    let result: Result<String, rusqlite::Error> =
+        conn.query_row("SELECT value FROM kv_store WHERE key = ?1", params![key], |row| {
+            row.get(0)
+        });
+    match result {
+        Ok(v) => Ok(Some(v)),
+        Err(rusqlite::Error::QueryReturnedNoRows) => Ok(None),
+        Err(e) => Err(e.into()),
+    }
+}
+
+/// 写 KV（UPSERT）；空值写入等于删除。
+pub fn kv_set(pool: &DbPool, key: &str, value: &str) -> Result<(), AppErrorKind> {
+    let conn = pool.get()?;
+    if value.is_empty() {
+        conn.execute("DELETE FROM kv_store WHERE key = ?1", params![key])?;
+        return Ok(());
+    }
+    conn.execute(
+        "INSERT INTO kv_store (key, value) VALUES (?1, ?2)
+         ON CONFLICT(key) DO UPDATE SET value = ?2, updated_at = CURRENT_TIMESTAMP",
+        params![key, value],
+    )?;
+    Ok(())
+}
