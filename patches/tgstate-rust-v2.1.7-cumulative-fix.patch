+/// P2 手动逃生口查询参数：force_db=1 时跳过 Telegram 删除。
+#[derive(Debug, Default, Deserialize)]
+struct DeleteFileQuery {
+    force_db: Option<String>,
+}
+
+/// 解析 force_db 布尔值（1/true/yes/on，大小写不敏感）。
+fn is_force_db(raw: &Option<String>) -> bool {
+    match raw.as_deref().map(|v| v.trim().to_ascii_lowercase()) {
+        Some(v) => matches!(v.as_str(), "1" | "true" | "yes" | "on"),
+        None => false,
+    }
+}
+
+/// 与面板 DELETE /api/files/:file_id 相同的删除流程（主消息 + 分块 + DB 行）。
+async fn delete_file_bot(
+    State(state): State<Arc<AppState>>,
+    Path(file_id): Path<String>,
+    Query(q): Query<DeleteFileQuery>,
+) -> Response {
+    // P2：手动逃生口 —— force_db 时完全不调用 Telegram，只删数据库行。
+    // 用途：频道消息超 48 小时永久不可删、或 TG 侧故障时，人工清理面板记录。
+    if is_force_db(&q.force_db) {
+        tracing::warn!(
+            "[bot-delete] force_db 生效，跳过 Telegram 删除 file_id={}",
+            file_id
+        );
+        let db_deleted = database::delete_file_metadata(&state.db_pool, &file_id).unwrap_or(false);
+        if db_deleted {
+            broadcast_delete(&state, &file_id);
+        }
+        tracing::warn!(
+            "[bot-delete] force_db 完成 file_id={} db_deleted={}",
+            file_id,
+            db_deleted
+        );
+        return Json(json!({
+            "status": "ok",
+            "message": format!(
+                "文件 {} 已从数据库删除（force_db：未调用 Telegram，频道侧消息可能残留）",
+                file_id
+            ),
+            "force_db": true,
+            "tg_orphaned": true,
+            "details": {
+                "db": if db_deleted { "deleted" } else { "not_found_in_db" },
+            }
+        }))
+        .into_response();
+    }
+
+    let tg = match get_telegram_service(&state) {
+        Ok(t) => t,
+        Err(resp) => return resp,
+    };
+
+    let tg_id = match database::get_file_by_id(&state.db_pool, &file_id) {
+        Ok(Some(f)) => f.file_id.clone(),
+        Ok(None) => file_id.clone(),
+        Err(e) => {
+            tracing::error!("删除前查询文件失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询文件失败", "db_error")
+                .into_response();
+        }
+    };
+
+    tracing::info!(
+        "[bot-delete] 收到删除请求 file_id={} -> tg_id={}",
+        file_id,
+        tg_id
+    );
+
+    let result = match tokio::time::timeout(
+        std::time::Duration::from_secs(30),
+        tg.delete_file_with_chunks(&tg_id),
+    )
+    .await
+    {
+        Ok(r) => r,
+        Err(_) => DeleteResult {
+            status: "timeout".into(),
+            main_file_id: tg_id.clone(),
+            deleted_chunks: vec![],
+            failed_chunks: vec![],
+            orphaned_chunks: vec![],
+            main_orphaned: false,
+            main_message_deleted: false,
+            main_delete_reason: "timeout".into(),
+            is_manifest: false,
+            reason: "telegram delete timeout".into(),
+        },
+    };
+
+    tracing::info!(
+        "[bot-delete] 结果 file_id={} status={} main_ok={} main_reason={} manifest={} deleted={} failed={} orphaned={} reason={}",
+        file_id,
+        result.status,
+        result.main_message_deleted,
+        result.main_delete_reason,
+        result.is_manifest,
+        result.deleted_chunks.len(),
+        result.failed_chunks.len(),
+        result.orphaned_count(),
+        result.reason
+    );
+
+    let db_deleted = if result.main_clear() {
+        database::delete_file_metadata(&state.db_pool, &file_id).unwrap_or(false)
+    } else {
+        false
+    };
+    if db_deleted {
+        broadcast_delete(&state, &file_id);
+    }
+
+    if result.main_clear() {
+        let db_status = if db_deleted { "deleted" } else { "not_found_in_db" };
+        if result.failed_chunks.is_empty() {
+            // P1：terminal_orphan 不算失败，但要在响应里明确告知残留条数。
+            let orphaned = result.orphaned_count();
+            let msg = if orphaned == 0 {
+                format!("文件 {} 已删除。", file_id)
+            } else {
+                format!(
+                    "文件 {} 已删除；{} 条频道消息超 48 小时无法删除，已残留",
+                    file_id, orphaned
+                )
+            };
+            return Json(json!({
+                "status": "ok",
+                "message": msg,
+                "tg_orphaned": orphaned > 0,
+                "orphaned_count": orphaned,
+                "details": { "db": db_status, "tg": result }
+            }))
+            .into_response();
+        }
+        return (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            Json(json!({
+                "status": "error",
+                "code": "partial_failure",
+                "message": "主文件已删，但部分分块删除失败",
+                "details": { "db": db_status, "tg": result }
+            })),
+        )
+            .into_response();
+    }
+
+    (
+        StatusCode::BAD_GATEWAY,
+        Json(json!({
+            "status": "error",
+            "code": "delete_failed",
+            "message": format!("Telegram 删除失败：{}", result.reason),
+            "details": { "tg": result }
+        })),
+    )
+        .into_response()
+}
+
+/// 按 "/" 分段逐层解析目录路径，返回目标目录 id（根目录为 None）。
+/// 支持 "." 与 ".." 段；任一层目录不存在即报 404。
+async fn resolve_folder_path(state: &Arc<AppState>, raw: &str) -> Result<Option<i64>, Response> {
+    let mut cur: Option<i64> = None;
+    for seg in raw.split('/') {
+        let seg = seg.trim();
+        if seg.is_empty() || seg == "." {
+            continue;
+        }
+        if seg == ".." {
+            cur = match cur {
+                None => {
+                    return Err(
+                        http_error(StatusCode::BAD_REQUEST, "路径已到根目录之上", "bad_path")
+                            .into_response(),
+                    )
+                }
+                Some(id) => match database::get_folder(&state.db_pool, id) {
+                    Ok(Some(f)) => f.parent_id,
+                    Ok(None) => {
+                        return Err(http_error(
+                            StatusCode::NOT_FOUND,
+                            "目录不存在",
+                            "folder_not_found",
+                        )
+                        .into_response())
+                    }
+                    Err(e) => {
+                        tracing::error!("解析目录路径失败: {}", e);
+                        return Err(http_error(
+                            StatusCode::INTERNAL_SERVER_ERROR,
+                            "查询目录失败",
+                            "db_error",
+                        )
+                        .into_response());
+                    }
+                },
+            };
+            continue;
+        }
+        let (folders, _) = database::list_folder_children(&state.db_pool, cur).map_err(|e| {
+            tracing::error!("解析目录路径失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response()
+        })?;
+        match folders.iter().find(|f| f.name == seg) {
+            Some(f) => cur = Some(f.id),
+            None => {
+                tracing::warn!("移动目标目录不存在: {}", seg);
+                return Err(http_error(
+                    StatusCode::NOT_FOUND,
+                    "目录不存在",
+                    "folder_not_found",
+                )
+                .into_response())
+            }
+        }
+    }
+    Ok(cur)
+}
+
+// ------------------------------------------------------------------
+// 运行期凭据（夸克直链 Cookie）：bot /setcookie 写入，workflow 取用
+// ------------------------------------------------------------------
+
+#[derive(Deserialize)]
+struct QuarkCookieBody {
+    cookie: String,
+}
+
+const KV_QUARK_COOKIE: &str = "quark_cookie";
+const QUARK_COOKIE_MAX_LEN: usize = 8192;
+
+async fn get_quark_cookie(State(state): State<Arc<AppState>>) -> Response {
+    match database::kv_get(&state.db_pool, KV_QUARK_COOKIE) {
+        Ok(v) => Json(json!({ "cookie": v })).into_response(),
+        Err(e) => {
+            tracing::error!("bot 读取 Cookie 失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "读取失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+async fn set_quark_cookie(
+    State(state): State<Arc<AppState>>,
+    Json(body): Json<QuarkCookieBody>,
+) -> Response {
+    let cookie = body.cookie.trim().to_string();
+    if cookie.len() > QUARK_COOKIE_MAX_LEN {
+        return http_error(
+            StatusCode::BAD_REQUEST,
+            "Cookie 过长",
+            "cookie_too_long",
+        )
+        .into_response();
+    }
+    // 空值 = 清除；其余原样存（cookie 格式由上游保证，服务端不强校验）
+    match database::kv_set(&state.db_pool, KV_QUARK_COOKIE, &cookie) {
+        Ok(()) => {
+            let action = if cookie.is_empty() { "已清除" } else { "已更新" };
+            tracing::info!("bot 面 Quark Cookie {}", action);
+            Json(json!({
+                "status": "ok",
+                "message": format!("Cookie {}", action),
+                "cleared": cookie.is_empty(),
+            }))
+            .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 写入 Cookie 失败: {}", e);
+            http_error(StatusCode::INTERNAL_SERVER_ERROR, "写入失败", "db_error")
+                .into_response()
+        }
+    }
+}
+
+// ------------------------------------------------------------------
+// 路由
+// ------------------------------------------------------------------
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route(
+            "/api/bot/folders",
+            get(list_folder).post(create_folder),
+        )
+        .route("/api/bot/folders/:id", delete(delete_folder_cascade))
+        .route("/api/bot/folders/:id/rename", post(rename_folder))
+        .route("/api/bot/files/:file_id/move", post(move_file))
+        .route("/api/bot/quark-cookie", get(get_quark_cookie).post(set_quark_cookie))
+        .route(
+            "/api/bot/files/:file_id",
+            patch(rename_file).delete(delete_file_bot),
+        )
+        .layer(middleware::from_fn(require_bot_key))
+}
+
+/// 面板 UI 用的目录/文件管理路由（与 bot 共用同一批 handler）。
+/// 不带 X-Bot-Key 层：走全局会话鉴权（未登录返回 401）。
+pub fn panel_router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route(
+            "/api/folders",
+            get(list_folder).post(create_folder),
+        )
+        .route("/api/folders/:id", delete(delete_folder_cascade))
+        .route("/api/folders/:id/rename", post(rename_folder))
+        .route("/api/files/:file_id/move", post(move_file))
+        .route("/api/files/:file_id/rename", patch(rename_file))
+}
