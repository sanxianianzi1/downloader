+/// 级联删除目录：递归 CTE 收集子树 → 逐文件走与面板删除相同的
+/// 「TG 删主消息 + 分块 → DB 删行」流程 → 删除全部目录行。
+/// 主消息删除失败的文件移回根目录并列入 failed_files，便于稍后重试。
+async fn delete_folder_cascade(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<i64>,
+) -> Response {
+    let tg = match get_telegram_service(&state) {
+        Ok(t) => t,
+        Err(resp) => return resp,
+    };
+
+    match database::get_folder(&state.db_pool, id) {
+        Ok(Some(_)) => {}
+        Ok(None) => {
+            return http_error(StatusCode::NOT_FOUND, "目录不存在", "folder_not_found")
+                .into_response()
+        }
+        Err(e) => {
+            tracing::error!("bot 查询目录失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response();
+        }
+    }
+
+    let (folder_ids, files) = match database::collect_subtree(&state.db_pool, id) {
+        Ok(x) => x,
+        Err(e) => {
+            tracing::error!("bot 收集目录子树失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "查询目录失败", "db_error")
+                .into_response();
+        }
+    };
+
+    let mut files_deleted: u64 = 0;
+    let mut bytes_freed: i64 = 0;
+    let mut failed_files: Vec<serde_json::Value> = Vec::new();
+    let mut failed_chunks: Vec<String> = Vec::new();
+
+    for f in &files {
+        let result = match tokio::time::timeout(
+            std::time::Duration::from_secs(30),
+            tg.delete_file_with_chunks(&f.file_id),
+        )
+        .await
+        {
+            Ok(r) => r,
+            Err(_) => DeleteResult {
+                status: "timeout".into(),
+                main_file_id: f.file_id.clone(),
+                deleted_chunks: vec![],
+                failed_chunks: vec![],
+                orphaned_chunks: vec![],
+                main_orphaned: false,
+                main_message_deleted: false,
+                main_delete_reason: "timeout".into(),
+                is_manifest: false,
+                reason: "telegram delete timeout".into(),
+            },
+        };
+
+        if result.main_clear() {
+            if database::delete_file_metadata(&state.db_pool, &f.file_id).unwrap_or(false) {
+                files_deleted += 1;
+                bytes_freed += f.filesize;
+                broadcast_delete(&state, &f.file_id);
+            }
+            failed_chunks.extend(result.failed_chunks.iter().cloned());
+        } else {
+            // 保底：文件行保留，移回根目录，避免留下指向已不存在目录的行。
+            let _ = database::set_file_folder(&state.db_pool, &f.file_id, None);
+            failed_files.push(json!({
+                "short_id": f.short_id,
+                "filename": f.filename,
+                "reason": result.reason,
+            }));
+        }
+    }
+
+    match database::delete_folders_by_ids(&state.db_pool, &folder_ids) {
+        Ok(_) => {}
+        Err(e) => {
+            tracing::error!("bot 删除目录行失败: {}", e);
+            return http_error(StatusCode::INTERNAL_SERVER_ERROR, "删除目录失败", "db_error")
+                .into_response();
+        }
+    }
+
+    tracing::info!(
+        "bot 级联删除目录 id={}: 目录 {} 个，文件 {} 个，释放 {} 字节",
+        id,
+        folder_ids.len(),
+        files_deleted,
+        bytes_freed
+    );
+
+    Json(json!({
+        "status": "ok",
+        "folders_deleted": folder_ids.len(),
+        "files_deleted": files_deleted,
+        "bytes_freed": bytes_freed,
+        "failed_files": failed_files,
+        "failed_chunks": failed_chunks,
+    }))
+    .into_response()
+}
