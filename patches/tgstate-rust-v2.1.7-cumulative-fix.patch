-/// Maximum upload body size (512 MB)
-pub const MAX_UPLOAD_BODY_SIZE: usize = 512 * 1024 * 1024;
+/// Maximum upload body size, in bytes. Default 10 GiB; override at runtime
+/// with env `MAX_UPLOAD_BODY_SIZE_MB` (megabytes, minimum 16). The previous
+/// fixed 512 MiB cap rejected large video uploads during multipart read
+/// (DefaultBodyLimit aborts before the streaming handler runs).
+pub fn max_upload_body_size() -> usize {
+    const DEFAULT_MB: usize = 10 * 1024;
+    std::env::var("MAX_UPLOAD_BODY_SIZE_MB")
+        .ok()
+        .and_then(|v| v.trim().parse::<usize>().ok())
+        .filter(|v| *v >= 16)
+        .unwrap_or(DEFAULT_MB)
+        * 1024
+        * 1024
+}
 
 /// Telegram chunk size for large file uploads (~19.5 MB, under Telegram's 20MB limit)
 pub const TELEGRAM_CHUNK_SIZE: usize = (19.5 * 1024.0 * 1024.0) as usize;
@@ -65,5 +77,16 @@ pub const BATCH_DELETE_MAX: usize = 100;
