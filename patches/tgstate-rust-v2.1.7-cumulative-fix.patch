+    }
+
+    if let Some(pid) = target_folder_id {
+        match database::get_folder(&state.db_pool, pid) {
+            Ok(Some(_)) => {}
+            Ok(None) => {
+                return http_error(
+                    StatusCode::NOT_FOUND,
+                    "目标目录不存在",
+                    "target_folder_not_found",
+                )
+                .into_response()
+            }
+            Err(e) => {
